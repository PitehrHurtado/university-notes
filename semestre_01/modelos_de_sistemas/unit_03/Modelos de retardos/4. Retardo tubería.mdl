{UTF-8}
Entrada=
	50*pulse(1,0)
	~	
	~		|

Tasa de venta=
	Entrada
	~	
	~		|

Apartamentos en construcción= INTEG (
	Tasa de venta-Tasa de construcción,
		0)
	~	
	~		|

Tasa de construcción=
	DELAY FIXED(Tasa de venta, Tiempo de retardo, 0)
	~	
	~		|

Tiempo de retardo=
	2
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 5
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0078125
	~	Year [0,?]
	~	The time step for the simulation.
	|

