{UTF-8}
Ajuste en expectativas1=
	(pedidos reales-Demanda esperada homecenter)/Tiempo de ajuste expectativas1
	~	
	~		|

Ajuste en expectativas2=
	(Demanda esperada homecenter-Demanda esperada Ilko)/Tiempo de ajuste de expectativas2
	~	
	~		|

Demanda esperada homecenter= INTEG (
	Ajuste en expectativas1,
		50)
	~	
	~		|

Demanda esperada Ilko= INTEG (
	Ajuste en expectativas2,
		50)
	~	
	~		|

pedidos reales=
	50+50*PULSE(5, 1)
	~	
	~	50+STEP(50, 5)
		50+50*PULSE(5, 1)
		
		Las de Javier
		
		100*STEP(2,0)
		100*PULSE(0,1)
	|

Tiempo de ajuste de expectativas2=
	10
	~	
	~		|

Tiempo de ajuste expectativas1=
	10
	~	
	~		|

