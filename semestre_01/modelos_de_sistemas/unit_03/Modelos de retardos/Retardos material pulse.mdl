{UTF-8}
auxiliar=
	entrada*tiempo verificación docs
	~	
	~		|

entrada=
	120/60+2*PULSE(12*60, 60)
	~	personas/minuto
	~	120/60+step(120/60,12*60)
	|

sala de espera= INTEG (
	entrada-tasa1,
		0)
	~	personas
	~		|

Sala de verificación de docs= INTEG (
	tasa1-tasa2,
		0)
	~	personas
	~		|

sala revisión equipaje= INTEG (
	tasa2-tasa3,
		0)
	~	personas
	~		|

tasa1=
	sala de espera/tiempo verificación docs
	~	personas/minuto
	~		|

tasa2=
	Sala de verificación de docs/tiempo de requisa
	~	personas/(minuto*minuto)
	~		|

tasa3=
	sala revisión equipaje/tiempo revisión de equipaje
	~	personas/minuto
	~		|

tiempo de requisa=
	20
	~	minuto
	~		|

tiempo revisión de equipaje=
	20
	~	minuto
	~		|

tiempo verificación docs=
	20
	~	minuto
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 1000
	~	Minute
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Minute
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Minute [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0078125
	~	Minute [0,?]
	~	The time step for the simulation.
	|

