{UTF-8}
consumo=
	Población P*"Consumo per cápita: C"
	~	
	~		|

Recurso R= INTEG (
	-consumo,
		100)
	~	
	~		|

"Consumo per cápita: C"=
	0.01
	~	
	~		|

"fracción per cápita de muertes: D"=
	1-Recurso R/100
	~	
	~		|

"fracción per cápita de nacimientos: B"=
	0.5
	~	
	~		|

Muertes=
	"fracción per cápita de muertes: D"*Población P
	~	
	~		|

Nacimientos=
	Población P*"fracción per cápita de nacimientos: B"
	~	
	~		|

Población P= INTEG (
	Nacimientos-Muertes,
		5)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 30
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0078125
	~	Month [0,?]
	~	The time step for the simulation.
	|

