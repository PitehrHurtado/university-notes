{UTF-8}
Consumidor C= INTEG (
	crecimiento consumidor-muerte consumidor D,
		200)
	~	
	~		|

Consumo de recurso por individuo Q=
	0.02
	~	
	~		|

consumo recurso=
	Consumidor C*Consumo de recurso por individuo Q
	~	
	~		|

crecimiento consumidor=
	fracción crecimiento consumidor G*Recurso R
	~	
	~		|

crecimiento recurso W=
	5
	~	
	~		|

fracción crecimiento consumidor G=
	0.05
	~	
	~		|

muerte consumidor D=
	10
	~	
	~		|

Recurso R= INTEG (
	crecimiento recurso W-consumo recurso,
		200)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 1000
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0078125
	~	Month [0,?]
	~	The time step for the simulation.
	|

