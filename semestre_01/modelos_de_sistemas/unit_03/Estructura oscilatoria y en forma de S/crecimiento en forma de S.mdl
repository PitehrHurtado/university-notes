{UTF-8}
Capacidad de carga=
	10000
	~	
	~		|

flujo de entrada=
	Población P*fracción de crecimiento
	~	
	~		|

flujo de salida=
	fracción de crecimiento*Población P/Capacidad de carga*Población P
	~	
	~		|

flujo neto=
	flujo de entrada-flujo de salida
	~	
	~		|

fracción de crecimiento=
	0.5
	~	
	~		|

Población P= INTEG (
	flujo de entrada-flujo de salida,
		100)
	~	
	~		|

