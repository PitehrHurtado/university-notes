{UTF-8}
ajuste real temperatura=
	ajuste temperatura/tiempo ajuste
	~	
	~	SMOOTHI(ajuste temperatura, 5, 1)
		DELAY1I(ajuste temperatura, 5, 1)
	|

tiempo ajuste=
	5
	~	
	~		|

ajuste temperatura=
	temperatura deseada-Temperatura ducha
	~	
	~		|

temperatura deseada=
	37
	~	
	~		|

Temperatura ducha= INTEG (
	ajuste real temperatura,
		30)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 12
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

