{UTF-8}
Muertes de peces=A FUNCTION OF(Muertes de peces,Fracción de muertes,Población de peces\
		) ~~|
Muertes de peces=
	~	peces/Year
	~		|

Fracción de muertes=A FUNCTION OF(Fracción de muertes,Fracción de ocupación) ~~|
Fracción de muertes=
	~	1/Year
	~		|

Área=A FUNCTION OF(Área) ~~|
Área=
	~	km2
	~		|

Barcos=A FUNCTION OF(Barcos,Tasa de construcción) ~~|
Barcos= INTEG (
	Tasa de construcción,
		)
	~	barcos
	~		|

Capacidad de carga=A FUNCTION OF(Capacidad de carga) ~~|
Capacidad de carga=
	~	peces
	~		|

Captura por barco=A FUNCTION OF(Captura por barco,Densidad) ~~|
Captura por barco=
	~	peces/(Year*barcos)
	~		|

Costo de envio=A FUNCTION OF(Costo de envio) ~~|
Costo de envio=
	~	$/barcos
	~		|

Costo operativo promedio por barco=A FUNCTION OF(Costo operativo promedio por barco) ~~|
Costo operativo promedio por barco=
	~	$/(Year*barcos)
	~		|

Costos operativos=A FUNCTION OF(Costos operativos,Barcos,Costo operativo promedio por barco\
		) ~~|
Costos operativos=
	~	$/Year
	~		|

Cuenta banco=A FUNCTION OF(Cuenta banco,Dépositos para el banco) ~~|
Cuenta banco= INTEG (
	Dépositos para el banco,
		)
	~	$
	~		|

Densidad=A FUNCTION OF(Densidad,Área,Población de peces) ~~|
Densidad=
	~	peces/km2
	~		|

Dépositos para el banco=A FUNCTION OF(Dépositos para el banco,Utilidades anuales) ~~|
Dépositos para el banco=
	~	$/Year
	~		|

Fracción invertida=A FUNCTION OF(Fracción invertida) ~~|
Fracción invertida=
	~	Dmnl
	~		|

Tasa de natalidad fraccional=A FUNCTION OF(Tasa de natalidad fraccional) ~~|
Tasa de natalidad fraccional=
	~	1/Year
	~		|

Fracción de ocupación=A FUNCTION OF(Fracción de ocupación,Capacidad de carga,Población de peces\
		) ~~|
Fracción de ocupación=
	~	Dmnl
	~		|

Ingresos=A FUNCTION OF(Ingresos,Peces capturados para pesca al año,Precio del pescado\
		) ~~|
Ingresos=
	~	$/Year
	~		|

Utilidades anuales=A FUNCTION OF(Utilidades anuales,Costos operativos,Ingresos) ~~|
Utilidades anuales=
	~	$/Year
	~		|

Nacimientos de peces=A FUNCTION OF(Nacimientos de peces,Población de peces,Tasa de natalidad fraccional\
		) ~~|
Nacimientos de peces=
	~	peces/Year
	~		|

Peces capturados para pesca al año=A FUNCTION OF(Peces capturados para pesca al año\
		,Barcos,Captura por barco) ~~|
Peces capturados para pesca al año=
	~	peces/Year
	~		|

Población de peces=A FUNCTION OF(Población de peces,Muertes de peces,Nacimientos de peces\
		,Peces capturados para pesca al año) ~~|
Población de peces= INTEG (
	Nacimientos de peces-Muertes de peces-Peces capturados para pesca al año,
		)
	~	peces
	~		|

Precio del pescado=A FUNCTION OF(Precio del pescado) ~~|
Precio del pescado=
	~	$/peces
	~		|

Tasa de construcción=A FUNCTION OF(Tasa de construcción,Costo de envio,Fracción invertida\
		,Utilidades anuales) ~~|
Tasa de construcción=
	~	barcos/Year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Year [0,?]
	~	The time step for the simulation.
	|

