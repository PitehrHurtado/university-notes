{UTF-8}
Adicion personas con Beta=
	IF THEN ELSE( (Aleatorio)>(1-Porcentaje personas con Beta) , Personas añadidas por periodo\
		 , 0 )
	~	
	~	IF((Aleatorio)>(1-'Fraccion blancas'),'Piedras añadidas por \
		periodo',0<<piedras/da>>)
	|

Adicion personas VHS=
	IF THEN ELSE(Aleatorio<Porcentaje personas con VHS, Personas añadidas por periodo ,\
		 0 )
	~	
	~	IF(Aleatorio<'Fraccion de negras','Piedras añadidas por \
		periodo',0<<piedras/da>>)
	|

Aleatorio=
	RANDOM UNIFORM( 0 , 1 ,0 )
	~	
	~		|

Porcentaje personas con Beta=
	Personas con Beta/Personas totales
	~	
	~		|

Porcentaje personas con VHS=
	Personas con VHS/Personas totales
	~	
	~		|

Personas añadidas por periodo=
	1
	~	
	~		|

Personas con Beta= INTEG (
	Adicion personas con Beta,
		1)
	~	
	~		|

Personas con VHS= INTEG (
	Adicion personas VHS,
		1)
	~	
	~		|

Personas totales=
	Personas con Beta+Personas con VHS
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 300
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

